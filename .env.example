# Spark2Pay Environment Configuration
# Copy this file to .env and update with your values.
# Defaults are judge-friendly: simulation PayPal mode + rules-engine AI,
# no keys required to run the full demo loop.

# ============================================
# Application Settings
# ============================================
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-key
PORT=3038

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite:///spark2pay.db

# ============================================
# PayPal Execution Layer
# ============================================
# mode: 'simulation' (deterministic local simulator, no credentials,
# full audit loop works offline) or 'sandbox' (real PayPal sandbox APIs)
PAYPAL_MODE=simulation

# Required when PAYPAL_MODE=sandbox
# Create a REST API app at https://developer.paypal.com/dashboard/
# (Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Webhook id for signature verification in sandbox mode
# (PayPal Developer Dashboard -> your webhook -> copy its id)
PAYPAL_WEBHOOK_ID=

# Public frontend URL used to build PayPal return/cancel links
FRONTEND_URL=http://localhost:5173

# ============================================
# AI Savings Engine
# ============================================
# provider: auto (OpenAI if a key exists, else the built-in rules engine),
# openai, gemini, ollama, or heuristic
AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini

# OpenAI API key - https://platform.openai.com/
# Enables the LLM savings agent with manage_with_paypal function calling
OPENAI_API_KEY=

# Optional OpenAI-compatible base URL override (proxies, Azure, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API key - https://makersuite.google.com/
GOOGLE_GEMINI_API_KEY=

# Ollama (local AI) - no key needed, https://ollama.ai/
OLLAMA_HOST=http://localhost:11434

# ============================================
# External APIs (Optional)
# ============================================

# Currency Exchange Rates (Fixer.io) - https://fixer.io/
FIXER_API_KEY=

# Google Vision API Key (OCR) - https://cloud.google.com/vision
GOOGLE_VISION_API_KEY=
# Tesseract OCR needs no key; it is the default local OCR engine

# ============================================
# Notification Channels (Optional)
# PayPal action results fan out to enabled channels
# ============================================

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pushover
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# ============================================
# Session & Security
# ============================================
SESSION_LIFETIME=2592000  # 30 days in seconds
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict

# ============================================
# File Uploads
# ============================================
MAX_UPLOAD_SIZE=16777216  # 16MB in bytes
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf,svg

# ============================================
# Frontend Configuration
# ============================================
BACKEND_URL=http://localhost:3038

# ============================================
# Production Settings (Update before deployment)
# ============================================
# CORS_ORIGINS=https://yourdomain.com
# HTTPS_ONLY=True
# DATABASE_URL=sqlite:////path/to/production/spark2pay.db
